# BAFO monorepo. Each app also has its own .gitignore; this file repeats the build outputs and
# secrets of all three so nothing slips in when the repository is initialised at the root.
# Never commit real keys: only the *.example files carry placeholders.

# --- OS, editors, tooling --------------------------------------------------------------------
.DS_Store
Thumbs.db
Icon?
*.swp
*~
.idea/
.vscode/
.fleet/
.zed/
.cursor/
.codex/
.claude/
.history/
__pycache__/
*.pyc
.venv/
*.log

# --- Secrets anywhere (placeholders in *.example files only) ---------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist

# --- apps/api (Laravel 13) -------------------------------------------------------------------
apps/api/vendor/
apps/api/node_modules/
apps/api/auth.json
apps/api/.phpunit.cache/
apps/api/.phpunit.result.cache
apps/api/_ide_helper.php
apps/api/.phpactor.json
# Passport signing keys (generated by scripts/dev.sh or `php artisan passport:keys`)
apps/api/storage/*.key
apps/api/storage/pail/
# Runtime files (the storage/**/.gitignore files keep the directories themselves)
apps/api/storage/logs/*
!apps/api/storage/logs/.gitignore
apps/api/storage/app/private/*
!apps/api/storage/app/private/.gitignore
apps/api/storage/app/public/*
!apps/api/storage/app/public/.gitignore
apps/api/storage/framework/cache/data/*
!apps/api/storage/framework/cache/data/.gitignore
apps/api/storage/framework/sessions/*
!apps/api/storage/framework/sessions/.gitignore
apps/api/storage/framework/testing/*
!apps/api/storage/framework/testing/.gitignore
apps/api/storage/framework/views/*
!apps/api/storage/framework/views/.gitignore
apps/api/bootstrap/cache/*.php
apps/api/public/hot
apps/api/public/storage
apps/api/public/build/
apps/api/public/css/filament/
apps/api/public/js/filament/
apps/api/public/fonts/filament/
apps/api/public/fonts-manifest.dev.json
apps/api/database/*.sqlite*

# --- apps/web (Nuxt 4) -----------------------------------------------------------------------
apps/web/node_modules/
apps/web/.nuxt/
apps/web/.output/
apps/web/.data/
apps/web/.nitro/
apps/web/.cache/
apps/web/dist/
apps/web/coverage/
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/

# --- apps/mobile (Flutter) -------------------------------------------------------------------
apps/mobile/build/
apps/mobile/coverage/
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.pub-cache/
apps/mobile/.pub/
apps/mobile/.widget_preview/
apps/mobile/app.*.symbols
apps/mobile/app.*.map.json
# Local build configuration (copy env/dev.example.json)
apps/mobile/env/*.json
!apps/mobile/env/*.example.json
# Android
apps/mobile/android/.gradle/
apps/mobile/android/.kotlin/
apps/mobile/android/captures/
apps/mobile/android/local.properties
apps/mobile/android/app/debug/
apps/mobile/android/app/profile/
apps/mobile/android/app/release/
apps/mobile/android/app/.cxx/
apps/mobile/android/**/GeneratedPluginRegistrant.java
# iOS
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/**/DerivedData/
apps/mobile/ios/**/xcuserdata/
apps/mobile/ios/Flutter/.last_build_id
apps/mobile/ios/Flutter/App.framework
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Flutter/ephemeral/
apps/mobile/ios/Flutter/flutter_export_environment.sh
apps/mobile/ios/Runner/GeneratedPluginRegistrant.*

# --- Release artefacts -----------------------------------------------------------------------
*.apk
*.aab
*.ipa
*.dSYM.zip

# --- Client-confidential research and proposal (kept local; repo is public) ---------------
docs/01_findings/
docs/02_design/
docs/03_proposal/
