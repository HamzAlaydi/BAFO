includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
    excludePaths:
        # Module config files are config files: env() is correct there (merged into config('bafo.<module>')).
        - app/Modules/*/config.php
    tmpDir: storage/framework/cache/phpstan
    ignoreErrors:
        # Shared-kernel traits are analysed once a model uses them (HasPublicId: first module models).
        -
            identifier: trait.unused
            path: app/Support/Database/Concerns/*
            reportUnmatched: false
