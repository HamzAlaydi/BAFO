APP_NAME=BAFO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Web origin used for links in e-mails (Nuxt dev server).
WEB_URL=http://localhost:3000

# Arabic-first. Clients pick the language per request with Accept-Language: ar|en.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_SUPPORTED_LOCALES=ar,en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17 over the unix socket in /tmp (TCP with DB_HOST=127.0.0.1 also works locally).
DB_CONNECTION=pgsql
DB_HOST=/tmp
DB_PORT=5432
DB_DATABASE=bafo
DB_USERNAME=hamzaalaydi
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=bafo-cache-

MEMCACHED_HOST=127.0.0.1

# phpredis is not installed locally; predis is a composer dependency.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=bafo-database-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bafo.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# First-party clients allowed by CORS (Nuxt dev server).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web and mobile authenticate with Sanctum personal access tokens (no SPA cookies).
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=129600

# Module keys (docs/build/ARCHITECTURE.md §15.2). External services run as fake/sandbox
# drivers by default. Placeholders only: never commit real keys.

# Platform
PDF_DRIVER=mpdf

# Identity: fixed OTP code, honoured in local and testing only (e.g. 123456). Empty = random codes.
OTP_FAKE_CODE=

# Billing
PAYMENT_GATEWAY=fake
PAYMENT_FAKE_AUTO_APPROVE=false
MOYASAR_BASE_URL=https://api.moyasar.com
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
EINVOICING_DRIVER=fake
BILLING_ALLOWED_RETURN_URLS=http://localhost:3000
SELLER_NAME_AR="BAFO (placeholder)"
SELLER_NAME_EN="BAFO (placeholder)"
SELLER_VAT_NUMBER=300000000000003
SELLER_CR_NUMBER=0000000000
SELLER_ADDRESS="Riyadh, Saudi Arabia (placeholder)"

# Notifications
PUSH_DRIVER=log

# Integrations
API_KEY_ENV=test
WEBHOOKS_ALLOW_PRIVATE_TARGETS=true

# Admin. The seeded super_admin (ARCHITECTURE §17): empty = the local demo credentials of DemoSeeder.
# ADMIN_MFA_REQUIRED must be true in production (ARCHITECTURE §16); false is for local development only.
ADMIN_MFA_REQUIRED=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Laravel Reverb (websocket server on :8085). Generate your own values locally.
# REVERB_PUBLIC_HOST/REVERB_PORT/REVERB_SCHEME are handed to clients by GET /api/app/v1/app-config.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=localhost
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8085
