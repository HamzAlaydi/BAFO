# Copy to .env for local overrides. Placeholders only: never commit real keys.

# First-party API (Laravel, apps/api)
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/app/v1

# Private-channel authorisation endpoint used by Laravel Echo (bearer token)
NUXT_PUBLIC_BROADCAST_AUTH_ENDPOINT=http://localhost:8000/broadcasting/auth

# Laravel Reverb. The app reads these from GET /app-config (AppConfig.realtime); a non-empty key
# here overrides them in development only (e.g. to point a local build at another Reverb).
NUXT_PUBLIC_REVERB_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8085
NUXT_PUBLIC_REVERB_SCHEME=http

# Absolute site URL for canonical and hreflang links
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000
